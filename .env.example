# ─── Authentication ────────────────────────────────────────────────────────────
# Secret key required in x-api-key header for all endpoints except /health
API_SECRET=change-me-to-a-strong-random-secret

# ─── LLM Provider (primary) ────────────────────────────────────────────────────
# Provider to use for AI vision: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# API key for the primary LLM provider.
# For LLM_PROVIDER=ollama, this can be left empty.
LLM_API_KEY=your-anthropic-or-openai-api-key-here

# Base URL for OpenAI-compatible endpoints (required for ollama)
# LLM_BASE_URL=http://localhost:11434/v1

# Primary model (required for ollama)
LLM_MODEL_PRIMARY=claude-haiku-4-5-20251001

# Fallback model (more capable, used when confidence is low)
LLM_MODEL_FALLBACK=claude-sonnet-4-20250514

# ─── LLM Fallback Provider (optional) ─────────────────────────────────────────
# If set, low-confidence results escalate to this provider instead of the fallback model
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_API_KEY=your-fallback-api-key-here

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on
PORT=3001

# Port noVNC WebSocket proxy listens on (for manual login sessions)
VNC_PORT=6080

# ─── Storage ───────────────────────────────────────────────────────────────────
# Directory where profiles/, registry.json, and debug/ live
# Inside Docker this is always /app/data (mounted as a volume)
DATA_DIR=/app/data

# ─── Browser ───────────────────────────────────────────────────────────────────
# Max seconds a browser instance is allowed to run before force-closing
MAX_BROWSER_TIMEOUT=120

# ─── Dolphin Anty (optional) ───────────────────────────────────────────────────
# Local REST API URL of the Dolphin Anty app. Required only if using Dolphin profiles.
# Note: Dolphin defaults to port 3001 — change PORT above if running on the same host.
# DOLPHIN_API_URL=http://localhost:3001

# Bearer token for the Dolphin Anty API.
# Generate at: https://dolphin-anty.com/panel → API tokens → Generate token
# The token is shown only once — copy it immediately.
# DOLPHIN_API_TOKEN=your-dolphin-api-token-here

# ─── AI Behaviour ──────────────────────────────────────────────────────────────
# Max number of AI retries per action step
MAX_AI_RETRIES=3

# Save screenshots on AI failure to /data/debug/ (true | false)
SAVE_DEBUG_SCREENSHOTS=true

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Minimum seconds between posts for the same avatar+platform
RATE_LIMIT_MIN_INTERVAL=60

# Maximum posts per avatar+platform per calendar day
RATE_LIMIT_DAILY_MAX=20

# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
