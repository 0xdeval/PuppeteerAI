FROM runpod/base:0.4.0-cuda11.8.0

# ─── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    procps \
    zstd \
    gnupg \
    openssh-client \
    rsync \
    # Playwright / Chromium runtime deps
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    # Virtual display for headed browser sessions
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# ─── Node.js 20 ───────────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ─── Ollama ───────────────────────────────────────────────────────────────────
RUN curl -fsSL https://ollama.com/install.sh | sh

# ─── Pre-download Ollama model at build time ──────────────────────────────────
# Store models in a fixed path so entrypoint.sh can find them at runtime.
# This layer is ~8-9 GB and is the whole point of the custom image.
ENV OLLAMA_MODELS=/ollama-models
RUN bash -c '\
    echo "[build] Disk space before pull:"; df -h /; \
    mkdir -p /ollama-models && chmod 755 /ollama-models; \
    ollama serve & OLLAMA_PID=$!; \
    echo "[build] Waiting for Ollama to start..."; \
    until ollama list >/dev/null 2>&1; do sleep 2; done; \
    echo "[build] Ollama ready. Pulling qwen3-vl:8b..."; \
    ollama pull qwen3-vl:8b; \
    STATUS=$?; \
    kill $OLLAMA_PID 2>/dev/null; \
    echo "[build] Disk space after pull:"; df -h /; \
    echo "[build] Pull exit status: $STATUS"; \
    exit $STATUS'

# ─── Pre-install Node dependencies ───────────────────────────────────────────
# Copy only package.json so this layer is cached independently of source code.
# At runtime the repo is cloned on top of /app; node_modules stay in place.
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev

# ─── Pre-install Playwright Chromium ─────────────────────────────────────────
RUN npx playwright install --with-deps chromium

# ─── Data directory skeleton ──────────────────────────────────────────────────
RUN mkdir -p /app/data/profiles /app/data/debug \
    && echo '{"profiles":{}}' > /app/data/registry.json

# ─── Runtime entrypoint ───────────────────────────────────────────────────────
COPY runpod-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3001 11434

ENTRYPOINT ["/entrypoint.sh"]
